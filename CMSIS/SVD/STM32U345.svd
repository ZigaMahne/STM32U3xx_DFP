                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Save RTC timestamp on TAMP1 detection event (whatever TAMPTS value)</description>
                  <value>0x1</value>
