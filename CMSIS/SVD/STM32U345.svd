                <enumeratedValue>
                  <name>B_0x5</name>
                  <description>THRless thansub&gt;H less than/sub&gt;is 18 dB higher than ANLVL</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x6</name>
                  <description>THRless thansub&gt;H less than/sub&gt;is 21.</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x7</name>
                  <description>THRless thansub&gt;H less than/sub&gt;is 24.</description>
                  <value>0x7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x8</name>
                  <description>THRless thansub&gt;H less than/sub&gt;is 27.</description>
                  <value>0x8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x9</name>
                  <description>THRless thansub&gt;H less than/sub&gt;is 30.</description>
                  <value>0x9</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ANSLP</name>
