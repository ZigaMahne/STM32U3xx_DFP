                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>GPDMA_CxSAR update</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>UB1</name>
              <description>This bit controls the update of GPDMA_C10BR1 from the memory during the link transfer. If UB1 = 0 and if GPDMA_C10LLR is not equal to 0, the linked-list is not completed. GPDMA_C10BR1.BNDT[15:0] is then restored to the programmed value after data transfer is completed and before the link transfer. 
0: no GPDMA_C10BR1 update from memory (GPDMA_C10BR1.BNDT[15:0] restored if any link transfer)
