              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TREFRESH2</name>
              <description>Refresh time = (TREFRESH[7:0]) x LSI / LSE clock period
Note: This register can be modified only when EN2 = 0.
Note: These bits are available only on dual-channel DACs. Refer to  less than xe1 [Implementation]/&gt;.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DAC_AUTOCR</name>
          <displayName>DAC_AUTOCR</displayName>
          <description>DAC Autonomous mode control register </description>
