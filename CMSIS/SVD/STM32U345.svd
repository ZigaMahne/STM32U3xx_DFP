              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>8-bit instruction</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>16-bit instruction</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2</name>
                  <description>24-bit instruction</description>
