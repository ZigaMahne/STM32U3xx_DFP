          <fields>
            <field>
              <name>CRCPOLY</name>
              <description>CRC polynomial register
</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SPI_TxCRC</name>
          <displayName>SPI_TxCRC</displayName>
