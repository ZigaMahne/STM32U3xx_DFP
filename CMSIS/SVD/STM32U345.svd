              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>no delay</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>1 clock cycle period delay</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0xF</name>
                  <description>15 clock cycle periods delay</description>
                  <value>0xF</value>
                </enumeratedValue>
