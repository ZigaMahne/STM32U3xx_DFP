                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Save RTC timestamp on any internal tamper detection event (whatever TAMPTS value)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
