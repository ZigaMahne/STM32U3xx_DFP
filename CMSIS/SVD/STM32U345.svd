                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Activate the Set-once mode</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
