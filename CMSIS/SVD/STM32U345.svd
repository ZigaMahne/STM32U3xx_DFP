                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>The LPTIM output reflects the inverse of the compare results between LPTIM_CNT and LPTIM_CCRx registers</description>
                  <value>0x1</value>
