        <register>
          <name>GTZC1_TZSC_PRIVCFGR3</name>
          <displayName>GTZC1 TZSC privilege configuration register 3</displayName>
          <description>Write-privileged access only.
This register can be read or written only by secure privileged transaction when corresponding GTZC1_TZSC_SECCFGR register signal is set to1. If a given SEC bit is not set, the equivalent PRIV bit can be read/written by non-secure privileged transaction.
Read accesses are authorized for any type of transactions, secure or not, privileged or not.</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
